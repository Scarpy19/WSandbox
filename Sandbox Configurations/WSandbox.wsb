<Configuration>

	<!-- Portable example: update HostFolder paths to match your machine/repo location. -->
	<Networking>Default</Networking>
	<ClipboardRedirection>Enable</ClipboardRedirection>
	<ProtectedClient>Disable</ProtectedClient>
	<VideoInput>Disable</VideoInput>
	<AudioInput>Disable</AudioInput>
	<PrinterRedirection>Disable</PrinterRedirection>
	<vGPU>Disable</vGPU>

	<MappedFolders>
		<!-- Repo/tools shared folder (read/write so installers can update cache folders). UPDATE HostFolder to this repo's path on your machine. -->
		<MappedFolder>
			<HostFolder>E:\WSandbox</HostFolder>
			<SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\HostShared</SandboxFolder>
			<ReadOnly>false</ReadOnly>
		</MappedFolder>

		<!-- Optional: map a downloads/cache folder (read-only recommended). -->
		<!--
		<MappedFolder>
			<HostFolder>C:\Path\To\DownloadsOrCache</HostFolder>
			<SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\Downloads</SandboxFolder>
			<ReadOnly>true</ReadOnly>
		</MappedFolder>
		-->
	</MappedFolders>

	<LogonCommand>
		<!-- Visible PowerShell window. Runs SandboxStartup.ps1 automatically on sandbox launch. -->
		<Command>powershell -executionpolicy Bypass -command "start powershell {-NoExit -File C:\Users\WDAGUtilityAccount\Desktop\HostShared\SandboxStartup.ps1 -launchingSandbox -ApplyDarkTheme}"</Command>

		<!-- Examples:
		Auto-install Winget and apply dark theme:
		<Command>powershell -executionpolicy Bypass -command "start powershell {-NoExit -File C:\Users\WDAGUtilityAccount\Desktop\HostShared\SandboxStartup.ps1 -launchingSandbox -InstallWinget -ApplyDarkTheme}"</Command>

		Use custom DNS:
		<Command>powershell -executionpolicy Bypass -command "start powershell {-NoExit -File C:\Users\WDAGUtilityAccount\Desktop\HostShared\SandboxStartup.ps1 -launchingSandbox -SetDns -DnsServer 1.1.1.1}"</Command>

		Run theme script manually with time range:
		<Command>powershell -executionpolicy Bypass -file "C:\Users\WDAGUtilityAccount\Desktop\HostShared\Theme\Dark-Mode.ps1" -AutoRange "18:00-06:00"</Command>
		-->
	</LogonCommand>

</Configuration>
